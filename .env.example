# LinuxServer containers user/group IDs — run `id` to find yours.
# These must match the ownership of the media library, or the *arr apps
# fail imports with UnauthorizedAccessException.
PUID=1000
PGID=1000

# Timezone
TZ=America/Los_Angeles

# ProtonVPN WireGuard private key, from the ProtonVPN account's WireGuard
# configuration generator. Pick a server that supports NAT-PMP port
# forwarding, since gluetun is configured with PORT_FORWARD_ONLY=on.
WIREGUARD_PRIVATE_KEY=PUT_WIREGUARD_PRIVATE_KEY_HERE

# Kavita API key, from Kavita > Settings > Account > API Key.
# Used by scripts/sync-kavita-reading-lists.py.
KAVITA_API_KEY=PUT_KAVITA_API_KEY_HERE
