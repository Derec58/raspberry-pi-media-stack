# Secrets
.env

# VPN files (often contain sensitive info)
vpn/
*.ovpn
*.conf

# App configs / databases (do not commit)
config/

# OS/editor cruft
.DS_Store
Thumbs.db
*.log

# Optional: docker override files
docker-compose.override.yml
logs/

# Timestamped backups of compose/.env
backups/

# Python bytecode from the helper scripts
__pycache__/

# Generated by the comic tooling — regenerable, churns every run
_match.json
sw_*.csv

# Agent session settings, machine-specific
.claude/

# Personal collection data, deliberately untracked and purged from history.
# These hold reading orders, buying plans and a personal comic collection; the
# repo is public and linked from a portfolio, so it should show infrastructure.
DC_Absolute.txt
MARVEL_SWIMSUIT_SPECIALS.txt
READING-ORDER-scarlet-witch.md
scarlet_witch_reading_order*.txt
sw_buying_plan.md
sw_*.csv
_match.json
scripts/sync-kavita-reading-lists.py
scripts/collection-config.json
