[Unit]
Description=Sync qBittorrent VPN tunnel IP with gluetun tun0
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=root
ExecStart=/bin/bash -c 'while true; do /home/korn/media-stack/scripts/sync-qbit-vpn-ip.sh; sleep 30; done'
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
